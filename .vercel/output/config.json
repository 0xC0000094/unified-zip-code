{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/barangays/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/lookup/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/municipalities/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/provinces/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/search/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}