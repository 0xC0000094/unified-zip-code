    "preview": "astro preview",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "philippines",
    "postal-code",
    "zip-code",
    "barangay",
    "psgc",
    "addressing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "private": "false",
  "dependencies": {
    "@astrojs/vercel": "^11.0.5",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.2"
  }
}
