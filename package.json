  "description": "A seven character postal code for the Philippines, resolving to the barangay. The delivered code set for all 42,047 barangays, with a lookup.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js test/*.test.ts",
    "extract": "python3 scripts/extract.py",
